<%- include('partials/admin_header', { title: 'Dashboard' }) %>
<%- include('partials/admin_sidebar', { page: 'dashboard' }) %>

<!-- Page header -->
<div class="ui-pagehead">
    <div>
        <div class="ui-crumbs"><span>Panel admin</span><span aria-hidden="true">/</span><span aria-current="page">Dashboard</span></div>
        <h1 class="ui-pagehead__title">Ringkasan operasi</h1>
        <p class="ui-pagehead__desc">
            Status server, kamera, penyimpanan dan layanan pendukung.
            <span class="ui-num" id="dash-updated" style="color:var(--fg-subtle)"></span>
        </p>
    </div>
    <div class="ui-row" style="flex-wrap:wrap">
        <button type="button" class="ui-btn" onclick="fetchSystemInfo();checkSystemServices();">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.5-5.8"/><path d="M20 3.5V8h-4.5"/></svg>
            Segarkan
        </button>
        <a href="<%= base_path %>/admin/cameras" class="ui-btn ui-btn--primary">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="6" width="12.5" height="12" rx="2"/><path d="m15 10.5 5.5-3v9l-5.5-3"/></svg>
            Kelola kamera
        </a>
    </div>
</div>

<!-- Server summary -->
<section class="ui-card" id="serverBanner">
    <div class="ui-card__head">
        <span id="serverDot" class="ui-dot dot--live" style="background:var(--fg-subtle)" aria-hidden="true"></span>
        <div>
            <div class="ui-card__title" id="serverName">CCTV Server</div>
            <div class="ui-card__meta" id="serverUptime">Checking...</div>
        </div>
        <div class="ui-card__actions ui-hide-sm" style="gap:var(--space-5)">
            <div style="text-align:right">
                <div class="ui-num" id="serverCpuLoad" style="font-weight:600">--</div>
                <div class="ui-card__meta">CPU load</div>
            </div>
            <div style="text-align:right">
                <div class="ui-num" id="serverMemUsage" style="font-weight:600">--</div>
                <div class="ui-card__meta">Memory</div>
            </div>
            <div style="text-align:right">
                <div class="ui-num" id="serverDiskUsage" style="font-weight:600">--</div>
                <div class="ui-card__meta">Disk</div>
            </div>
            <div style="text-align:right">
                <div class="ui-num" id="serverArch" style="font-weight:600">--</div>
                <div class="ui-card__meta">Arsitektur</div>
            </div>
        </div>
    </div>
</section>

<!-- KPI -->
<div class="ui-grid-kpi">

    <section class="ui-kpi">
        <div class="ui-kpi__label">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="6" width="12.5" height="12" rx="2"/><path d="m15 10.5 5.5-3v9l-5.5-3"/></svg>
            Status kamera
            <span id="cam-online-badge" class="ui-badge ui-badge--neutral" style="margin-left:auto">Checking...</span>
        </div>
        <div class="ui-kpi__value"><span id="cam-online-count" style="color:var(--accent-text)">0</span> <small>online</small></div>
        <div class="ui-kpi__foot">
            <span id="cam-offline-count" style="color:var(--danger-text)">0</span> offline ·
            total <%= cameras.length %> unit terdaftar
        </div>
    </section>

    <section class="ui-kpi">
        <div class="ui-kpi__label">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M4.5 20a7.5 7.5 0 0 1 15 0"/></svg>
            Total pelanggan
            <span class="ui-badge ui-badge--info" style="margin-left:auto">Aktif</span>
        </div>
        <div class="ui-kpi__value"><%= users.length %> <small>user</small></div>
        <div class="ui-kpi__foot">Pengguna terdaftar</div>
    </section>

    <section class="ui-kpi">
        <div class="ui-kpi__label">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="12" cy="6.5" rx="7.5" ry="3"/><path d="M4.5 6.5v11c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3v-11"/><path d="M4.5 12c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3"/></svg>
            Penyimpanan
            <span id="disk-percent-badge" class="ui-badge ui-badge--warn" style="margin-left:auto">--</span>
        </div>
        <div class="ui-kpi__value" id="disk-text" style="font-size:var(--text-20)">--</div>
        <div class="ui-kpi__foot">Kapasitas rekaman</div>
    </section>

    <section class="ui-kpi">
        <div class="ui-kpi__label">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M13 10V3L4 14h7v7l9-11h-7Z"/></svg>
            AI object counter
            <span id="ai-status-badge" class="ui-badge ui-badge--neutral" style="margin-left:auto">Checking...</span>
        </div>
        <div class="ui-kpi__value" id="ai-status-text">0 <small>kamera aktif</small></div>
        <div class="ui-kpi__foot" id="ai-today-subtext" style="color:var(--accent-text)">0 objek terhitung hari ini</div>
    </section>
</div>

<!-- System monitor -->
<div style="display:grid;grid-template-columns:minmax(0,1fr);gap:var(--space-4)" class="dash-split">

    <section class="ui-card">
        <div class="ui-card__head">
            <div>
                <div class="ui-card__title">Beban sistem</div>
                <div class="ui-card__meta">CPU, memori, dan disk</div>
            </div>
        </div>
        <div class="ui-card__body">
            <div class="ui-meter-list">
                <div class="ui-meter">
                    <div class="ui-meter__row"><span>CPU</span><span class="ui-num" id="cpu-percent">0%</span></div>
                    <div class="ui-meter__bar"><div id="cpu-bar" style="width:0%"></div></div>
                    <div class="ui-meter__row" style="color:var(--fg-subtle);font-size:var(--text-11)">
                        <span id="cpu-load-1">0.00</span>
                        <span id="cpu-load-5">0.00</span>
                        <span id="cpu-load-15">0.00</span>
                    </div>
                </div>

                <div class="ui-meter">
                    <div class="ui-meter__row"><span>Memori</span><span class="ui-num" id="mem-percent">0%</span></div>
                    <div class="ui-meter__bar"><div id="mem-bar" style="width:0%"></div></div>
                    <div class="ui-meter__row" style="color:var(--fg-subtle);font-size:var(--text-11)">
                        <span id="mem-used">0 GB</span>
                        <span id="mem-free">0 GB</span>
                        <span id="mem-total">0 GB</span>
                    </div>
                </div>

                <div class="ui-meter">
                    <div class="ui-meter__row"><span>Disk</span><span class="ui-num" id="disk-percent">0%</span></div>
                    <div class="ui-meter__bar"><div id="disk-bar" style="width:0%"></div></div>
                    <div class="ui-meter__row" style="color:var(--fg-subtle);font-size:var(--text-11)">
                        <span id="disk-used">0 GB</span>
                        <span id="disk-free">0 GB</span>
                        <span id="disk-total">0 GB</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="ui-card">
        <div class="ui-card__head">
            <div>
                <div class="ui-card__title">Informasi sistem</div>
                <div class="ui-card__meta">Host dan runtime</div>
            </div>
        </div>
        <div class="ui-card__body">
            <div class="ui-stack" style="gap:6px">
                <div class="ui-kv"><span>Hostname</span><span class="ui-num" id="sys-hostname">--</span></div>
                <div class="ui-kv"><span>Platform</span><span id="sys-platform">--</span></div>
                <div class="ui-kv"><span>Arsitektur</span><span class="ui-num" id="sys-arch">--</span></div>
                <div class="ui-kv"><span>Prosesor</span><span id="sys-cpu" style="text-align:right">--</span></div>
                <div class="ui-kv"><span>CPU cores</span><span class="ui-num" id="sys-cores">--</span></div>
                <div class="ui-kv"><span>Suhu CPU</span><span class="ui-num" id="sys-temp">--</span></div>
                <div class="ui-kv"><span>Uptime server</span><span class="ui-num" id="sys-uptime" style="color:var(--accent-text)">--</span></div>
                <div class="ui-kv"><span>Node.js</span><span class="ui-num" id="sys-node">--</span></div>
                <div class="ui-kv"><span>Versi aplikasi</span><span class="ui-num" id="sys-version" style="color:var(--accent-text)">--</span></div>
                <div class="ui-kv"><span>AI engine</span><span id="sys-ai">Checking...</span></div>
            </div>
        </div>
    </section>

    <section class="ui-card">
        <div class="ui-card__head">
            <div>
                <div class="ui-card__title">Partisi disk</div>
                <div class="ui-card__meta">Penggunaan per mount point</div>
            </div>
        </div>
        <div class="ui-card__body" id="disks-container">
            <div class="ui-empty">Memuat informasi disk…</div>
        </div>
    </section>

    <section class="ui-card">
        <div class="ui-card__head">
            <div>
                <div class="ui-card__title">Status layanan</div>
                <div class="ui-card__meta">Pemeriksaan tiap 30 detik</div>
            </div>
        </div>
        <div class="ui-card__body">
            <div class="ui-stack" style="gap:6px">
                <div class="ui-kv">
                    <span class="ui-row"><span id="srv-mediamtx" class="ui-dot" style="background:var(--fg-subtle)" aria-hidden="true"></span> MediaMTX API</span>
                    <span id="srv-mediamtx-txt" class="ui-badge ui-badge--neutral">Checking...</span>
                </div>
                <div class="ui-kv">
                    <span class="ui-row"><span id="srv-hls" class="ui-dot" style="background:var(--fg-subtle)" aria-hidden="true"></span> HLS streamer</span>
                    <span id="srv-hls-txt" class="ui-badge ui-badge--neutral">Checking...</span>
                </div>
                <div class="ui-kv">
                    <span class="ui-row"><span id="srv-ffmpeg" class="ui-dot" style="background:var(--fg-subtle)" aria-hidden="true"></span> FFmpeg engine</span>
                    <span id="srv-ffmpeg-txt" class="ui-badge ui-badge--neutral">Checking...</span>
                </div>
                <div class="ui-kv">
                    <span class="ui-row"><span id="srv-ai" class="ui-dot" style="background:var(--fg-subtle)" aria-hidden="true"></span> AI engine</span>
                    <span id="srv-ai-txt" class="ui-badge ui-badge--neutral">Checking...</span>
                </div>
                <div class="ui-kv">
                    <span class="ui-row"><span id="srv-whatsapp" class="ui-dot" style="background:var(--fg-subtle)" aria-hidden="true"></span> WhatsApp bot</span>
                    <span id="srv-whatsapp-txt" class="ui-badge ui-badge--neutral">Checking...</span>
                </div>
                <div class="ui-kv">
                    <span class="ui-row"><span id="srv-telegram" class="ui-dot" style="background:var(--fg-subtle)" aria-hidden="true"></span> Telegram bot</span>
                    <span id="srv-telegram-txt" class="ui-badge ui-badge--neutral">Checking...</span>
                </div>
                <div class="ui-kv">
                    <span class="ui-row"><span id="srv-sqlite" class="ui-dot" style="background:var(--fg-subtle)" aria-hidden="true"></span> Database SQLite</span>
                    <span id="srv-sqlite-txt" class="ui-badge ui-badge--neutral">Checking...</span>
                </div>
            </div>
        </div>
    </section>
</div>

<style>
    @media (min-width: 1100px) {
        .dash-split { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) !important; }
    }
</style>

<script>
async function fetchSystemInfo() {
    try {
        const res = await fetch('<%= base_path %>/api/system/info');
        const data = await res.json();
        if (!data.success) return;
        
        const s = data.data;
        
        // Server Banner
        document.getElementById('serverDot').className = 'w-3 h-3 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.5)]';
        document.getElementById('serverName').innerText = s.hostname || 'CCTV Server';
        
        const uptimeStr = formatUptime(s.uptime_sec);
        document.getElementById('serverUptime').innerText = 'Online since ' + uptimeStr;
        document.getElementById('serverCpuLoad').innerText = (s.cpu_load || 0).toFixed(1);
        document.getElementById('serverMemUsage').innerText = (s.memory_percent || 0).toFixed(0) + '%';
        document.getElementById('serverDiskUsage').innerText = (s.disk_percent || 0).toFixed(0) + '%';
        document.getElementById('serverArch').innerText = s.arch || '--';
        
        // CPU
        const cpuPct = Math.min(100, Math.round((s.cpu_load || 0) / (s.cpu_cores || 1) * 100));
        document.getElementById('cpu-percent').innerText = cpuPct + '%';
        const cpuBar = document.getElementById('cpu-bar');
        cpuBar.style.width = cpuPct + '%';
        cpuBar.className = 'h-full rounded-full transition-all duration-1000 ' + (cpuPct > 80 ? 'bg-rose-500' : cpuPct > 50 ? 'bg-amber-500' : 'bg-emerald-500');
        document.getElementById('cpu-load-1').innerText = '1m: ' + (s.cpu_load || 0).toFixed(2);
        document.getElementById('cpu-load-5').innerText = '5m: ' + (s.cpu_load_5 || 0).toFixed(2);
        document.getElementById('cpu-load-15').innerText = '15m: ' + (s.cpu_load_15 || 0).toFixed(2);
        
        // Memory
        const memPct = Math.round(s.memory_percent || 0);
        document.getElementById('mem-percent').innerText = memPct + '%';
        const memBar = document.getElementById('mem-bar');
        memBar.style.width = memPct + '%';
        memBar.className = 'h-full rounded-full transition-all duration-1000 ' + (memPct > 80 ? 'bg-rose-500' : memPct > 50 ? 'bg-amber-500' : 'bg-blue-500');
        document.getElementById('mem-used').innerText = s.memory_used || '0 GB';
        document.getElementById('mem-free').innerText = s.memory_free || '0 GB';
        document.getElementById('mem-total').innerText = s.memory_total || '0 GB';
        
        // Disk
        const diskPct = Math.round(s.disk_percent || 0);
        document.getElementById('disk-percent').innerText = diskPct + '%';
        const diskBar = document.getElementById('disk-bar');
        diskBar.style.width = diskPct + '%';
        diskBar.className = 'h-full rounded-full transition-all duration-1000 ' + (diskPct > 80 ? 'bg-rose-500' : diskPct > 60 ? 'bg-amber-500' : 'bg-orange-500');
        document.getElementById('disk-used').innerText = s.disk_used || '0 GB';
        document.getElementById('disk-free').innerText = s.disk_free || '0 GB';
        document.getElementById('disk-total').innerText = s.disk_total || '0 GB';
        
        // System Info
        document.getElementById('sys-hostname').innerText = s.hostname || '--';
        document.getElementById('sys-platform').innerText = s.platform || '--';
        document.getElementById('sys-arch').innerText = s.arch || '--';
        document.getElementById('sys-cpu').innerText = s.cpu_model || '--';
        document.getElementById('sys-cores').innerText = s.cpu_cores + ' Cores' || '--';
        document.getElementById('sys-temp').innerText = s.cpu_temp || '--';
        document.getElementById('sys-uptime').innerText = formatUptime(s.uptime_sec);
        document.getElementById('sys-node').innerText = s.node_version || '--';
        document.getElementById('sys-version').innerText = s.app_version || '--';
        
        // AI Status
        if (s.ai_engine && s.ai_engine.status === 'ok') {
            document.getElementById('sys-ai').innerHTML = '<span class="text-emerald-400">Online</span> (' + (s.ai_engine.active_cameras||0) + ' cam)';
        } else {
            document.getElementById('sys-ai').innerHTML = '<span class="text-rose-400">Offline</span>';
        }
        
        // Disk Partitions
        if (s.disks && s.disks.length > 0) {
            const dc = document.getElementById('disks-container');
            dc.innerHTML = '';
            s.disks.forEach(function(d, i) {
                const pct = Math.round(d.percent || 0);
                const color = pct > 80 ? 'bg-rose-500' : pct > 60 ? 'bg-amber-500' : 'bg-orange-500';
                dc.innerHTML += '<div class="p-3 bg-gray-900/50 rounded-xl border border-gray-700">' +
                    '<div class="flex justify-between text-xs mb-1.5">' +
                        '<span class="text-gray-400 font-medium">' + (d.mounted || d.filesystem || 'Disk ' + (i+1)) + '</span>' +
                        '<span class="text-white font-bold">' + pct + '%</span>' +
                    '</div>' +
                    '<div class="h-1.5 bg-gray-800 rounded-full overflow-hidden">' +
                        '<div class="h-full rounded-full ' + color + '" style="width: ' + pct + '%"></div>' +
                    '</div>' +
                    '<div class="flex justify-between text-[9px] text-gray-600 mt-1">' +
                        '<span>' + (d.used || '0') + '</span>' +
                        '<span>' + (d.free || '0') + '</span>' +
                        '<span>' + (d.total || '0') + '</span>' +
                    '</div>' +
                '</div>';
            });
        }
        
        // Summary cards
        document.getElementById('disk-percent-badge').innerText = diskPct + '%';
        document.getElementById('disk-text').innerHTML = (s.disk_used_gb || '0') + ' <span class="text-sm font-normal text-gray-500">/ ' + (s.disk_total_gb || '0') + ' GB</span>';
        
    } catch(e) {
        console.error('[Dashboard] System info error:', e);
    }
}

async function checkSystemServices() {
    try {
        // Camera Status (Online / Offline counts)
        const camRes = await fetch('<%= base_path %>/api/cameras/status').then(r => r.json()).catch(() => ({}));
        if (camRes && camRes.success && camRes.cameras) {
            let online = 0;
            let offline = 0;
            const cList = Object.values(camRes.cameras);
            cList.forEach(c => {
                if (c.online) online++;
                else offline++;
            });
            
            const badge = document.getElementById('cam-online-badge');
            if (badge) {
                badge.innerText = online + ' ONLINE';
                badge.className = 'text-[10px] font-bold ' + (online > 0 ? 'text-emerald-500 bg-emerald-500/10' : 'text-rose-500 bg-rose-500/10') + ' px-2 py-1 rounded-lg uppercase tracking-widest';
            }
            const onEl = document.getElementById('cam-online-count');
            const offEl = document.getElementById('cam-offline-count');
            if (onEl) onEl.innerText = online;
            if (offEl) offEl.innerText = offline;
        }

        // MediaMTX
        const mtx = await fetch('<%= base_path %>/api/mediamtx/health').then(r => r.json()).catch(() => ({}));
        updateService('srv-mediamtx', mtx.success !== false, 'MediaMTX API', 'Running', 'Offline');
        
        // HLS (check port)
        const hls = await fetch('<%= base_path %>/api/system/disk').then(r => r.json()).catch(() => ({}));
        updateService('srv-hls', true, 'HLS Streamer', 'Active', 'Inactive');
        
        // FFmpeg
        const ff = await fetch('<%= base_path %>/api/youtube/check-ffmpeg').then(r => r.json()).catch(() => ({}));
        updateService('srv-ffmpeg', ff.available, 'FFmpeg Engine', 'Available', 'Missing');
        
        // AI Engine
        const ai = await fetch('<%= base_path %>/api/ai/health').then(r => r.json()).catch(() => ({}));
        const aiOk = ai && (ai.status === 'ok' || ai.active_cameras > 0);
        updateService('srv-ai', aiOk, 'AI Engine', 'Online', 'Offline');
        
        const aiBadge = document.getElementById('ai-status-badge');
        if (aiBadge) {
            aiBadge.innerText = aiOk ? 'Online' : 'Idle';
            aiBadge.className = 'text-[10px] font-bold ' + (aiOk ? 'text-emerald-500 bg-emerald-500/10' : 'text-amber-500 bg-amber-500/10') + ' px-2 py-1 rounded-lg uppercase tracking-widest';
        }
        const aiTxt = document.getElementById('ai-status-text');
        if (aiTxt) {
            aiTxt.innerHTML = (ai && ai.active_cameras || '0') + ' <span class="text-sm font-normal text-gray-400">Kamera Aktif</span>';
        }
        const aiSub = document.getElementById('ai-today-subtext');
        if (aiSub) {
            aiSub.innerText = (ai && ai.today_counts !== undefined ? ai.today_counts : 0) + ' objek terhitung hari ini';
        }
        
        // WhatsApp
        const wa = await fetch('<%= base_path %>/admin/whatsapp/status').then(r => r.json()).catch(() => ({}));
        updateService('srv-whatsapp', wa.connected, 'WhatsApp Bot', 'Connected', 'Disconnected');
        
        // Telegram
        const tg = await fetch('<%= base_path %>/api/settings/telegram').then(r => r.json()).catch(() => ({}));
        updateService('srv-telegram', false, 'Telegram Bot', 'Active', 'Inactive');
        
        // SQLite
        updateService('srv-sqlite', true, 'Database (SQLite)', 'Connected', 'Error');
        
    } catch(e) {
        console.error('[Dashboard] Service check error:', e);
    }
}

function updateService(dotId, isOk, name, okText, failText) {
    const dot = document.getElementById(dotId);
    const txt = document.getElementById(dotId + '-txt');
    if (dot) dot.className = 'w-2 h-2 rounded-full ' + (isOk ? 'bg-emerald-500 shadow-[0_0_6px_rgba(16,185,129,0.5)]' : 'bg-rose-500');
    if (txt) {
        txt.innerText = isOk ? okText : failText;
        txt.className = 'text-[10px] font-bold uppercase tracking-widest ' + (isOk ? 'text-emerald-500' : 'text-rose-500');
    }
}

function formatUptime(seconds) {
    if (!seconds) return '--';
    const d = Math.floor(seconds / 86400);
    const h = Math.floor((seconds % 86400) / 3600);
    const m = Math.floor((seconds % 3600) / 60);
    const s = Math.floor(seconds % 60);
    let parts = [];
    if (d > 0) parts.push(d + 'd');
    if (h > 0) parts.push(h + 'h');
    if (m > 0) parts.push(m + 'm');
    parts.push(s + 's');
    return parts.join(' ');
}

document.addEventListener('DOMContentLoaded', function() {
    fetchSystemInfo();
    checkSystemServices();
    setInterval(fetchSystemInfo, 10000);
    setInterval(checkSystemServices, 30000);
});
</script>

<%- include('partials/admin_footer') %>
