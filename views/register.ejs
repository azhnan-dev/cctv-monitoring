<%- include('partials/auth_head', { base_path: base_path, pageTitle: 'Daftar Akun | CCTV' }) %>

<div class="ui-auth">

    <!-- Panel brand -->
    <section class="ui-auth__brand" aria-label="Tentang layanan">
        <div class="ui-row" style="gap:8px">
            <span class="ui-brandmark" aria-hidden="true">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <rect x="2.5" y="6" width="12.5" height="12" rx="2"/><path d="m15 10.5 5.5-3v9l-5.5-3"/>
                </svg>
            </span>
            <div>
                <div style="font-size:13px;font-weight:600"><%= (typeof site !== 'undefined' && site.title) ? site.title : 'CCTV Alijaya' %></div>
                <div style="font-size:11px;color:var(--fg-muted)">Pendaftaran pelanggan</div>
            </div>
        </div>

        <div class="ui-stack" style="gap:var(--space-4)">
            <h1 class="ui-auth__claim">Daftar sekali, pantau dari mana saja.</h1>
            <p class="ui-auth__lead">
                Akun baru mendapat akses kamera level <strong style="color:var(--fg)">UMUM</strong>.
                Naik level dilakukan oleh admin setelah verifikasi.
            </p>

            <ul class="ui-checklist">
                <li>
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11"/></svg>
                    Isi data diri dan pilih username
                </li>
                <li>
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11"/></svg>
                    Masuk dan pilih kamera yang tersedia
                </li>
                <li>
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11"/></svg>
                    Ajukan upgrade akses lewat admin
                </li>
            </ul>
        </div>

        <div class="ui-auth__stats">
            <div class="ui-auth__stat"><b>Gratis</b><span>pendaftaran akun</span></div>
            <div class="ui-auth__stat"><b>UMUM</b><span>level awal</span></div>
            <div class="ui-auth__stat"><b>3</b><span>langkah aktivasi</span></div>
        </div>
    </section>

    <!-- Form -->
    <section class="ui-auth__form">
        <div class="ui-auth__card" style="max-width:440px">

            <div>
                <h2 class="ui-auth__title">Pendaftaran akun baru</h2>
                <p class="ui-auth__sub">Kolom bertanda wajib harus diisi.</p>
            </div>

            <% if (locals.error) { %>
                <div class="ui-alert ui-alert--danger" role="alert" tabindex="-1">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" style="margin-top:1px" aria-hidden="true">
                        <path d="M12 4.5 21 20H3Z"/><path d="M12 10v4.5M12 17.2v.3"/>
                    </svg>
                    <span><%= error %></span>
                </div>
            <% } %>

            <div class="ui-alert ui-alert--danger" id="auth-error-summary" role="alert" tabindex="-1" hidden></div>

            <form action="<%= base_path %>/user/register" method="POST" class="ui-stack" style="gap:var(--space-3)" data-auth-form novalidate>

                <div class="ui-field">
                    <label class="ui-label" for="full_name">Nama lengkap <span class="ui-label__opt">(opsional)</span></label>
                    <input class="ui-input" type="text" id="full_name" name="full_name" autocomplete="name" placeholder="Nama sesuai identitas">
                </div>

                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:var(--space-3)">
                    <div class="ui-field">
                        <label class="ui-label" for="email">Email <span class="ui-label__opt">(opsional)</span></label>
                        <input class="ui-input" type="email" id="email" name="email" autocomplete="email" placeholder="email@contoh.com">
                    </div>

                    <div class="ui-field">
                        <label class="ui-label" for="phone">Nomor HP <span class="ui-label__opt">(opsional)</span></label>
                        <input class="ui-input" type="tel" id="phone" name="phone" autocomplete="tel" placeholder="0812...">
                    </div>
                </div>

                <div class="ui-field">
                    <label class="ui-label" for="username">Username</label>
                    <input class="ui-input" type="text" id="username" name="username" required
                           autocomplete="username" placeholder="Pilih username" aria-describedby="username-error">
                    <span class="ui-hint">Dipakai untuk masuk, tidak bisa diubah sendiri.</span>
                    <span class="ui-errortext" id="username-error" hidden>
                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4.5 21 20H3Z"/><path d="M12 10v4.5M12 17.2v.3"/></svg>
                        Username wajib diisi.
                    </span>
                </div>

                <div class="ui-field">
                    <label class="ui-label" for="password">Kata sandi</label>
                    <div class="ui-inputgroup">
                        <input class="ui-input" type="password" id="password" name="password" required
                               autocomplete="new-password" placeholder="••••••••" aria-describedby="password-error">
                        <button class="ui-inputgroup__btn" type="button" data-toggle-pass="password"
                                aria-pressed="false" aria-label="Tampilkan kata sandi">
                            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="3"/>
                            </svg>
                        </button>
                    </div>
                    <span class="ui-errortext" id="password-error" hidden>
                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4.5 21 20H3Z"/><path d="M12 10v4.5M12 17.2v.3"/></svg>
                        Kata sandi wajib diisi.
                    </span>
                </div>

                <button class="ui-btn ui-btn--primary ui-btn--lg" type="submit" style="width:100%;margin-top:4px">
                    Daftar sekarang
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4.5 12h15m-5.5-5.5L19.5 12 14 17.5"/>
                    </svg>
                </button>
            </form>

            <hr class="ui-divider">

            <p style="font-size:var(--text-12);color:var(--fg-muted);text-align:center">
                Sudah punya akun?
                <a href="<%= base_path %>/user/login" class="ui-link">Masuk di sini</a>
            </p>

            <a href="<%= base_path %>/" class="ui-btn ui-btn--ghost ui-btn--sm" style="align-self:center">&larr; Kembali ke beranda</a>
        </div>
    </section>
</div>

<%- include('partials/auth_scripts', { base_path: base_path }) %>
