                            <div class="ui-row" style="gap:6px;min-width:0">
                                ${isEmbed
                                    ? `<span class="ui-badge ui-badge--info" style="height:16px">Embed</span>`
                                    : `<span class="pulse-dot" style="width:6px;height:6px;border-radius:50%;background:var(--accent-text);display:inline-block;flex:none"></span>`}
                                <span style="font-size:12px;font-weight:600;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-shadow:0 1px 2px rgba(0,0,0,.6)">${cam?.nama || 'Kamera'}</span>
                            </div>
                            <div style="font-size:11px;color:rgba(255,255,255,.72);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${cam?.lokasi || ''}</div>
                        </div>
                    </div>

                    <!-- Overlay AI counter -->
                    ${hasAi ? `
                    <div id="ai-overlay-${id}" style="position:absolute;top:8px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:8px;padding:4px 8px;border-radius:var(--radius-md);background:rgba(5,8,15,.86);border:1px solid var(--border-strong);color:#fff;z-index:10;pointer-events:none">
                        <span class="ui-row" style="gap:4px;color:var(--accent-text);font-size:10px;font-weight:600">
                            <span class="pulse-dot" style="width:5px;height:5px;border-radius:50%;background:currentColor"></span> AI
                        </span>
                        <span style="width:1px;height:12px;background:var(--border-strong)"></span>
                        <span class="ui-num" style="font-size:11px">Orang <strong id="ai-count-person-${id}" style="color:var(--accent-text)">0</strong></span>
                        <span class="ui-num" style="font-size:11px">Motor <strong id="ai-count-motorcycle-${id}" style="color:var(--accent-text)">0</strong></span>
                        <span class="ui-num" style="font-size:11px">Mobil <strong id="ai-count-car-${id}" style="color:var(--accent-text)">0</strong></span>
                        <span class="ui-num" style="font-size:11px">Truk <strong id="ai-count-truck-${id}" style="color:var(--accent-text)">0</strong></span>
                    </div>
                    ` : ''}

                    <!-- Aksi (muncul saat hover / fokus keyboard) -->
                    ${!isEmbed ? `<div class="ui-row" style="position:absolute;inset:auto 0 0 0;justify-content:flex-end;gap:4px;padding:6px 8px;background:linear-gradient(0deg,rgba(0,0,0,.72),transparent);opacity:0;transition:opacity .18s var(--ease-out);z-index:20" class="video-actions group-hover:opacity-100 group-focus-within:opacity-100">
                        <button onclick="takeScreenshot('video-${id}', '${cam?.nama || 'Camera'}')" aria-label="Ambil tangkapan layar ${cam?.nama || ''}" title="Tangkapan layar" class="btn-press" style="width:26px;height:26px;display:grid;place-items:center;border-radius:var(--radius-sm);background:rgba(0,0,0,.55);border:1px solid rgba(255,255,255,.18);color:#fff;cursor:pointer">
                            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2"/><circle cx="8.5" cy="9.5" r="1.5"/><path d="m4.5 17 5-5 4 4 2.5-2.5 3.5 3.5"/></svg>
                        </button>
                        <button onclick="toggleFullscreen('video-${id}')" aria-label="Layar penuh ${cam?.nama || ''}" title="Layar penuh" class="btn-press" style="width:26px;height:26px;display:grid;place-items:center;border-radius:var(--radius-sm);background:rgba(0,0,0,.55);border:1px solid rgba(255,255,255,.18);color:#fff;cursor:pointer">
                            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3.5H3.5V9M15 3.5h5.5V9M9 20.5H3.5V15M15 20.5h5.5V15"/></svg>
                        </button>
                    </div>` : ''}
                </div>
                `;
            }).join('');

            selectedCameraIds.forEach(id => {
                const cam = cameras.find(c => String(c.id) === id);
                if (!cam) return;

                const wrapper = document.getElementById(`wrapper-${id}`);
                
                if (!cam.isPlayable) {
                    wrapper.innerHTML = `
                        <div style="position:absolute;inset:0;background:var(--surface-2);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;text-align:center;gap:8px">
                            <svg width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="color:var(--danger-text)" aria-hidden="true"><rect x="4.5" y="10.5" width="15" height="9" rx="2"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/></svg>
                            <strong style="font-size:12px;color:var(--fg)">${cam.nama} terkunci</strong>
                            <span style="font-size:11px;color:var(--fg-muted)">Butuh level ${cam.level.toUpperCase()}</span>
                            <a href="${basePath}/user/login" class="ui-btn ui-btn--primary ui-btn--sm" style="margin-top:4px">Upgrade / masuk</a>
                        </div>
                    `;
                    return;
                }

                // Handle Embed Camera
                if (cam.camera_type === 'embed') {
                    const embedContainer = document.getElementById(`embed-${id}`);
                    if (embedContainer && cam.embed_url) {
                        const embedType = cam.embed_type || detectEmbedType(cam.embed_url);
                        embedContainer.innerHTML = generateEmbedHtml(cam);
                        // Initialize HLS if needed (script in innerHTML won't execute)
                        if (embedType === 'hls') {
                            setTimeout(() => initEmbedHls(cam.id, cam.embed_url), 100);
                        }
                    }
                    return;
                }

                // Handle RTSP Camera (existing logic)
                const v = document.getElementById(`video-${id}`);
                if (!v) {
                    console.warn(`Video element not found for camera ${id}`);
                    return;
                }

                const primaryUrl = `${hlsBase}/cam_${id}/index.m3u8`;
                const fallbackUrl = `${hlsBase}/cam_${id}_input/index.m3u8`;
                
                console.log(`Initializing HLS for camera ${id}:`, primaryUrl);
                
                // Destroy existing instance
                if (hlsInstances[id]) {
                    hlsInstances[id].destroy();
                    delete hlsInstances[id];
                }
                
                // Helper function to hide loading indicator
                const hideLoading = () => {
                    const loadingEl = document.getElementById(`loading-${id}`);
                    if (loadingEl && loadingEl.style.display !== 'none') {
                        loadingEl.style.opacity = '0';
                        setTimeout(() => {
                            loadingEl.style.display = 'none';
                        }, 300);
                    }
                };
                
                // Timeout to force hide loading after 15 seconds
                const loadingTimeout = setTimeout(() => {
                    console.warn(`Loading timeout for camera ${id}, hiding loading indicator`);
                    hideLoading();
                }, 15000);
                
                // Clear timeout when loading is hidden
                const originalHideLoading = hideLoading;
                const hideLoadingWithTimeout = () => {
                    clearTimeout(loadingTimeout);
                    originalHideLoading();
                };
                
                if (Hls.isSupported()) {
                    const hls = new Hls({
                        manifestLoadingMaxRetry: 2,
                        manifestLoadingRetryDelay: 1000,
                        debug: false
                    });
                    
                    hls.loadSource(primaryUrl);
                    hls.attachMedia(v);
                    
                    // Hide loading when video starts playing
                    v.addEventListener('playing', hideLoadingWithTimeout, { once: true });
                    v.addEventListener('canplay', hideLoadingWithTimeout, { once: true });
                    
                    hls.on(Hls.Events.MANIFEST_PARSED, () => {
                        console.log(`HLS manifest parsed for camera ${id}`);
                        v.play().catch(e => console.warn(`Play failed for camera ${id}:`, e));
                    });
                    
                    hls.on(Hls.Events.ERROR, (event, data) => {
                        console.error(`HLS error for camera ${id}:`, data.type, data.details);
                        if (data.fatal) {
                            console.log(`Trying fallback URL for camera ${id}:`, fallbackUrl);
                            hls.destroy();
                            
                            // Try fallback
                            const hlsFallback = new Hls({
                                manifestLoadingMaxRetry: 5,
                                manifestLoadingRetryDelay: 1000
                            });
                            hlsFallback.loadSource(fallbackUrl);
                            hlsFallback.attachMedia(v);
                            
                            // Add loading hide for fallback
                            v.addEventListener('playing', hideLoadingWithTimeout, { once: true });
                            
                            hlsFallback.on(Hls.Events.MANIFEST_PARSED, () => {
                                console.log(`Fallback HLS manifest parsed for camera ${id}`);
                                v.play().catch(() => {});
                            });
                            hlsInstances[id] = hlsFallback;
                        }
                    });
                    
                    hlsInstances[id] = hls;
                } else if (v.canPlayType('application/vnd.apple.mpegurl')) {
                    // Native HLS support (Safari, iOS)
                    console.log(`Using native HLS for camera ${id}`);
                    
                    v.addEventListener('playing', hideLoadingWithTimeout, { once: true });
                    v.addEventListener('canplay', hideLoadingWithTimeout, { once: true });
                    
                    v.src = primaryUrl;
                    v.play().catch(() => {
                        console.log(`Primary URL failed for camera ${id}, trying fallback`);
                        v.src = fallbackUrl;
                        v.play().catch(() => {
                            console.error(`Both URLs failed for camera ${id}`);
                        });
                    });
                }
            });
        }

        function renderMobileList() {
            const list = document.getElementById('mobile-camera-list');
            if (!list) return;
            
            const userLevel = (userStatus.customerLevel || 'umum').toLowerCase();
            
            list.innerHTML = cameras.map(cam => {
