<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0f172a">
    <link rel="manifest" href="<%= base_path %>/manifest.json">
    <link rel="icon" href="<%= base_path %>/icon-192x192.png">
    <link rel="apple-touch-icon" href="<%= base_path %>/icon-192x192.png">
    <title><%= site.title %> - Live Dashboard</title>
    
    <!-- Shared design tokens + Tailwind config (partials/theme_head.ejs) -->
    <%- include('partials/theme_head', { base_path: base_path, themeColor: '#0f172a' }) %>
    <script>
        /* Extend the shared token config with dashboard-specific motion + slate remap */
        tailwind.config = {
            ...tailwind.config,
            theme: {
                ...tailwind.config.theme,
                extend: {
                    ...tailwind.config.theme.extend,
                    colors: {
                        ...tailwind.config.theme.extend.colors,
                        slate: {
                            200: '#e2e8f0', 300: '#cbd5e1', 400: '#94a3b8', 500: '#64748b',
                            600: '#475569', 700: '#2a3448', 800: '#192134', 900: '#10192e', 950: '#0f172a'
                        }
                    },
                    animation: {
                        'marquee': 'marquee 30s linear infinite',
                        'fade-in': 'fadeIn 0.5s ease-out forwards',
                    },
                    keyframes: {
                        marquee: { '0%': { transform: 'translateX(100%)' }, '100%': { transform: 'translateX(-100%)' } },
                        fadeIn: { '0%': { opacity: '0', transform: 'translateY(10px)' }, '100%': { opacity: '1', transform: 'translateY(0)' } }
                    }
                }
            }
        };
    </script>
    <link rel="stylesheet" href="<%= base_path %>/css/leaflet.css" />
    
    <style>
        /* Theme variables — mapped onto the shared design tokens so every
           legacy rule on this page follows the same palette as admin. */
        :root {
            --bg-primary: var(--bg);
            --bg-secondary: var(--surface-2);
            --bg-tertiary: var(--surface);
            --text-primary: var(--fg);
            --text-secondary: #cbd5e1;
            --text-tertiary: var(--fg-muted);
            --border-color: var(--border);
            --glass-bg: var(--surface);
            --nav-bg: var(--surface);
            --sidebar-bg: var(--surface-2);
            --video-border: var(--border);
            --empty-slot-text: var(--border-strong);
            --scrollbar-thumb: var(--border-strong);
        }

        * { transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease; }
        
        body { 
            background-color: var(--bg-primary); 
            color: var(--text-primary); 
            font-family: 'Inter', sans-serif; 
        }
        .glass-panel { 
            background: var(--glass-bg); 
            backdrop-filter: blur(12px); 
            border: 1px solid var(--border-color); 
        }
        .sidebar-scroll::-webkit-scrollbar { width: 4px; }
        .sidebar-scroll::-webkit-scrollbar-track { background: transparent; }
        .sidebar-scroll::-webkit-scrollbar-thumb { 
            background: var(--scrollbar-thumb); 
            border-radius: 10px; 
        }
        
        #live-display { height: 100%; width: 100%; display: flex; flex-direction: column; gap: 0.75rem; overflow: hidden; }
        .live-grid { display: grid; gap: 1rem; width: 100%; height: 100%; flex: 1; min-height: 0; align-items: center; justify-items: center; transition: all 0.3s ease; }
        .grid-1 { grid-template-columns: 1fr; width: 100%; height: 100%; margin: 0 auto; display: flex; align-items: center; justify-content: center; }
        .grid-2 { grid-template-columns: repeat(2, 1fr); grid-template-rows: 1fr; width: 100%; height: 100%; }
        .grid-4 { grid-template-columns: repeat(2, 1fr); grid-template-rows: repeat(2, 1fr); width: 100%; height: 100%; }
        .grid-6 { grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(2, 1fr); width: 100%; height: 100%; }
        .grid-9 { grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr); width: 100%; height: 100%; }
        .grid-12 { grid-template-columns: repeat(4, 1fr); grid-template-rows: repeat(3, 1fr); width: 100%; height: 100%; }
        .grid-16 { grid-template-columns: repeat(4, 1fr); grid-template-rows: repeat(4, 1fr); width: 100%; height: 100%; }
        
        @media (min-width: 1024px) {
            .grid-1 { width: 100%; height: 100%; max-width: 100%; max-height: 100%; }
        }

        .video-wrapper {
            position: relative;
            width: 100%;
            height: 100%;
            max-width: 100%;
            max-height: 100%;
            aspect-ratio: 16 / 9;
            background: #000;
            border-radius: 0.75rem;
            overflow: hidden;
            border: 1px solid var(--video-border);
            box-shadow: 0 10px 30px -10px rgba(0,0,0,0.5);
            margin: auto;
        }
        .video-wrapper video { width: 100%; height: 100%; object-fit: cover; }
        @media (min-width: 1024px) {
            .video-wrapper video { object-fit: contain; }
        }
        
        .empty-slot { 
            width: 100%; 
            height: 100%; 
            max-width: 100%; 
            max-height: 100%; 
            aspect-ratio: 16 / 9; 
            background: #000; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            color: var(--empty-slot-text); 
            border-radius: 0.75rem; 
            border: 1px dashed var(--empty-slot-text); 
            margin: auto;
        }
        .camera-item.selected { border-color: var(--accent); background: var(--accent-soft); }
        
        .nav-tab {
            height: 26px;
            padding: 0 10px;
            border: 0;
            border-radius: var(--radius-sm);
            background: transparent;
            color: var(--fg-muted);
            font-size: var(--text-11);
            font-weight: var(--weight-semibold);
            transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
            cursor: pointer;
        }
        .nav-tab:hover { background: var(--surface-hover); color: var(--fg); }
        .nav-tab.active { background: var(--accent); color: var(--accent-fg); }
        .custom-div-icon { background: none !important; border: none !important; }
        .blink { animation: blink 1s steps(5, start) infinite; }
        @keyframes blink { to { visibility: hidden; } }
        
        /* Theme Toggle Button */
        .theme-toggle {
            position: relative;
            width: 32px;
            height: 32px;
            border-radius: var(--radius-md);
            background: transparent;
            border: 1px solid transparent;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--fg-muted);
            transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
        }
        .theme-toggle:hover { background: var(--surface-hover); color: var(--fg); }
        .theme-toggle svg {
            width: 18px;
            height: 18px;
            color: currentColor;
        }
        
        /* Theme-aware utility classes */
        .bg-primary { background-color: var(--bg-primary) !important; }
        .bg-secondary { background-color: var(--bg-secondary) !important; }
        .bg-tertiary { background-color: var(--bg-tertiary) !important; }
        .text-primary { color: var(--text-primary) !important; }
        .text-secondary { color: var(--text-secondary) !important; }
        .border-themed { border-color: var(--border-color) !important; }
        
        /* Override Tailwind for theme support */
        nav, aside, .glass-panel { background: var(--nav-bg) !important; }
        aside { background: var(--sidebar-bg) !important; }
        main { background: var(--bg-primary) !important; }
        
        [data-theme="light"] .bg-slate-900,
        [data-theme="light"] .bg-slate-900\/90,
        [data-theme="light"] .bg-slate-900\/95,
        [data-theme="light"] .bg-slate-900\/50 {
            background-color: rgba(255, 255, 255, 0.95) !important;
        }
        
        [data-theme="light"] .bg-slate-950,
        [data-theme="light"] .bg-slate-950\/50,
        [data-theme="light"] .bg-slate-950\/80 {
            background-color: rgba(248, 250, 252, 0.95) !important;
        }
        
        [data-theme="light"] .text-white,
        [data-theme="light"] .text-slate-200,
        [data-theme="light"] .text-slate-300 {
            color: #0f172a !important;
        }
        
        [data-theme="light"] .text-slate-400,
        [data-theme="light"] .text-slate-500 {
            color: #64748b !important;
        }
        
        [data-theme="light"] .text-slate-600,
        [data-theme="light"] .text-slate-700 {
            color: #475569 !important;
        }
        
        [data-theme="light"] .border-slate-700,
        [data-theme="light"] .border-slate-800 {
            border-color: #e2e8f0 !important;
        }
        
        [data-theme="light"] .shadow-2xl {
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15) !important;
        }
        
        /* ===== LOADING STATES & ANIMATIONS ===== */
        .loading-spinner {
            width: 40px;
            height: 40px;
            border: 3px solid var(--accent-soft);
            border-top: 3px solid var(--accent);
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        .pulse-dot {
            animation: pulse-dot 2s infinite;
        }
        
        @keyframes pulse-dot {
            0%, 100% { opacity: 0.4; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.1); }
        }
        
        /* Smooth hover effects */
        .hover-lift {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        
        .hover-lift:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        }
        
        /* Video loading overlay */
        .video-loading {
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, 0.8);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 12px;
            z-index: 10;
        }
        
        /* Notification animations */
        @keyframes slideInRight {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        
        @keyframes slideOutRight {
            from { transform: translateX(0); opacity: 1; }
            to { transform: translateX(100%); opacity: 0; }
        }
        
        .notification-enter {
            animation: slideInRight 0.3s ease-out;
        }
        
        .notification-exit {
            animation: slideOutRight 0.3s ease-in;
        }
        
        /* Button press effect */
        .btn-press {
            transition: transform 0.1s ease;
        }
        
        .btn-press:active {
            transform: scale(0.95);
        }
        
        /* Sidebar collapse - smooth & responsive approach */
        #desktopSidebar {
            transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1), min-width 0.3s cubic-bezier(0.4, 0, 0.2, 1), flex 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            will-change: width, min-width, flex, opacity;
        }
        #desktopSidebar.sidebar-closed {
            width: 0px !important;
            min-width: 0px !important;
            max-width: 0px !important;
            flex: 0 0 0px !important;
            overflow: hidden !important;
            padding: 0 !important;
            border-left: none !important;
            opacity: 0;
            margin-right: 0 !important;
        }
        #main-content-display {
            transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1), flex 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        #main-content-display.sidebar-closed {
            width: 100%;
            flex: 1 1 100%;
        }
        #sidebarToggle.toggle-visible {
            display: flex !important;
        }
        #sidebarToggle.toggle-hidden {
            display: none !important;
        }
        
        /* Skeleton loading for camera items */
        .skeleton {
            background: linear-gradient(90deg, 
                var(--bg-tertiary) 25%, 
                rgba(255,255,255,0.05) 50%, 
                var(--bg-tertiary) 75%);
            background-size: 200% 100%;
            animation: skeleton-loading 1.5s infinite;
        }
        
        @keyframes skeleton-loading {
            0% { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }
    </style>
    
    <script src="<%= base_path %>/js/hls.min.js"></script>
    <script src="<%= base_path %>/js/leaflet.js"></script>

    <!-- ======================================================================
         Dashboard-specific styling on top of tokens.css + ui.css
         (kept page-local so the shared component sheet stays admin-agnostic)
         ====================================================================== -->
    <style>
        /* Bottom navigation items (classes are swapped by switchMode) */
        .ui-bnav__icon {
            display: grid; place-items: center;
            width: 34px; height: 34px;
            border-radius: var(--radius-md);
            color: var(--fg-muted);
            transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
        }
        .ui-bnav__icon.is-active { background: var(--accent-soft); color: var(--accent-text); }
        .ui-bnav__label { font-size: 11px; font-weight: var(--weight-medium); color: var(--fg-muted); }
        .ui-bnav__label.is-active { color: var(--accent-text); font-weight: var(--weight-semibold); }

        /* Per-camera status text (classes are swapped by updateCameraStatusUI) */
        .ui-status-text {
            display: inline-block;
            font-size: 10px;
            font-weight: var(--weight-semibold);
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }
        .ui-status-text.is-online { color: var(--accent-text); }
        .ui-status-text.is-offline { color: var(--danger-text); }
        .ui-status-text.is-checking { color: var(--fg-subtle); }

        /* Camera list rows */
        .camera-item:hover { background: var(--surface-hover); }
        .camera-item:focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; }
        .camera-item.selected { border-color: var(--accent) !important; background: var(--accent-soft) !important; }

        /* Video tiles: flat surfaces, no lift, no glow */
        .live-grid { gap: 8px; }
        .video-wrapper {
            border-radius: var(--radius-lg);
            border-color: var(--border);
            box-shadow: none;
        }
        .video-wrapper:hover { border-color: var(--border-strong); }
        .hover-lift, .hover-lift:hover { transform: none; box-shadow: none; }
        .video-wrapper video { object-fit: contain; background: #000; }

        /* Sidebar toggle stays a thin edge handle */
        #sidebarToggle { transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out); }
        #sidebarToggle:hover { background: var(--surface-3); color: var(--fg); }

        /* Sticky-free scrollbars inside lists */
        #camera-list, #mobile-list-container { scrollbar-width: thin; scrollbar-color: var(--border-strong) transparent; }
    </style>
</head>
<body class="antialiased h-screen flex flex-col overflow-hidden">
    <%- include('partials/global_modal') %>

    <!-- Time Modal (Mobile) -->
    <div id="timeModal" onclick="closeTimeModal()" class="fixed inset-0 z-[110] hidden items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md animate-fade-in">
        <div onclick="event.stopPropagation()" class="bg-slate-900 border border-slate-800 w-full max-w-xs rounded-3xl shadow-2xl overflow-hidden p-8 flex flex-col items-center gap-6">
            <div class="w-16 h-16 bg-emerald-500/10 rounded-2xl flex items-center justify-center">
                <svg class="w-8 h-8 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <div class="text-center">
                <h2 id="modal-clock" class="text-4xl font-black text-white tracking-tighter mb-1">00:00:00</h2>
                <p id="modal-date" class="text-[10px] font-bold text-slate-500 uppercase tracking-[0.2em]">01 Januari 2026</p>
            </div>
            <div class="w-full h-px bg-slate-800"></div>
            <div class="flex items-center gap-3">
                <div class="w-2 h-2 bg-emerald-500 rounded-full blink"></div>
                <span class="text-[10px] font-black text-slate-300 uppercase tracking-widest">Server Live Status</span>
            </div>
            <button onclick="closeTimeModal()" class="mt-4 w-full py-3 bg-slate-800 text-white text-[10px] font-black rounded-xl uppercase tracking-widest hover:bg-slate-700 transition">Tutup</button>
        </div>
    </div>

    <!-- ===== Topbar ===== -->
    <header class="ui-topbar" style="gap:10px">
        <a class="ui-row" href="<%= base_path %>/" style="gap:8px;min-width:0">
            <span class="ui-brandmark" aria-hidden="true">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <rect x="2.5" y="6" width="12.5" height="12" rx="2"/><path d="m15 10.5 5.5-3v9l-5.5-3"/>
                </svg>
            </span>
            <div style="min-width:0">
                <div class="ui-topbar__title" style="overflow:hidden;text-overflow:ellipsis;max-width:26ch"><%= site.title %></div>
                <div class="ui-topbar__sub ui-hide-sm"><%= site.footer %></div>
            </div>
        </a>

        <div class="ui-vrule ui-hide-sm" aria-hidden="true"></div>

        <div class="ui-seg" role="tablist" aria-label="Mode tampilan">
            <button onclick="switchMode('live')" id="tab-live" class="nav-tab active" role="tab" aria-selected="true">Live</button>
            <button onclick="switchMode('map')" id="tab-map" class="nav-tab" role="tab" aria-selected="false">Peta</button>
        </div>

        <div class="ui-seg ui-hide-md" role="group" aria-label="Batas jumlah kamera">
            <button onclick="setGridPreset(1)" class="ui-seg__btn" title="Maksimal 1 kamera">1x1</button>
            <button onclick="setGridPreset(4)" class="ui-seg__btn" title="Maksimal 4 kamera">2x2</button>
            <button onclick="setGridPreset(9)" class="ui-seg__btn" title="Maksimal 9 kamera">3x3</button>
            <button onclick="setGridPreset(16)" class="ui-seg__btn" title="Maksimal 16 kamera">4x4</button>
        </div>

        <div class="ui-topbar__spacer"></div>

        <div class="ui-row ui-hide-md" style="gap:8px">
            <span id="topbar-clock" class="ui-num" style="font-size:14px;font-weight:600;letter-spacing:-0.02em">00:00:00</span>
            <span class="ui-vrule" aria-hidden="true"></span>
            <span id="topbar-date" style="font-size:11px;color:var(--fg-muted);white-space:nowrap">01 Januari 2026</span>
            <span class="ui-badge ui-badge--live"><span class="ui-badge__dot pulse-dot" aria-hidden="true"></span> Server live</span>
        </div>

        <!-- Mobile: jam -->
        <button onclick="showTimeModal()" class="ui-btn ui-btn--icon lg:hidden" aria-label="Lihat waktu dan tanggal">
            <span id="mobile-date-num" class="ui-num" style="font-size:13px;font-weight:600"><%= new Date().getDate() %></span>
        </button>

        <button id="weather-widget" onclick="showWeatherDetail()" class="ui-btn ui-btn--sm" style="gap:6px" aria-label="Detail cuaca">
            <span id="weather-icon" style="font-size:12px" aria-hidden="true">&#127780;</span>
            <span id="weather-temp" style="font-weight:600">--&deg;C</span>
        </button>

        <button onclick="cycleTheme()" class="theme-toggle" title="Ganti tema" id="theme-toggle-btn" aria-label="Ganti tema">
            <svg id="theme-icon-dark" class="hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
            </svg>
            <svg id="theme-icon-light" class="hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
            <svg id="theme-icon-auto" class="hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
            </svg>
        </button>

        <div class="ui-hide-sm ui-row" style="gap:4px">
            <a href="<%= base_path %>/archive" class="ui-btn ui-btn--ghost ui-btn--sm">Rekaman</a>
            <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                <a href="<%= base_path %>/admin" class="ui-btn ui-btn--ghost ui-btn--sm" style="color:var(--accent-text)">Admin</a>
                <a href="<%= base_path %>/user/logout" class="ui-btn ui-btn--danger ui-btn--sm">Keluar</a>
            <% } else if (typeof isCustomer !== 'undefined' && isCustomer) { %>
                <a href="<%= base_path %>/user/account" class="ui-btn ui-btn--ghost ui-btn--sm"><%= (customer.full_name || customer.username) %></a>
                <a href="<%= base_path %>/user/logout" class="ui-btn ui-btn--danger ui-btn--sm">Keluar</a>
            <% } else { %>
                <a href="<%= base_path %>/user/login" class="ui-btn ui-btn--primary ui-btn--sm">Masuk</a>
            <% } %>
        </div>
    </header>

    <!-- ===== Mobile bottom navigation ===== -->
    <nav class="ui-bottomnav" aria-label="Navigasi utama">
        <button onclick="switchMode('live')" id="m-tab-live" class="ui-bottomnav__item" aria-label="Tampilan live">
            <span class="ui-bnav__icon is-active" id="m-icon-live">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="6" width="12.5" height="12" rx="2"/><path d="m15 10.5 5.5-3v9l-5.5-3"/></svg>
            </span>
            <span class="ui-bnav__label is-active" id="m-text-live">Live</span>
        </button>

        <button onclick="switchMode('map')" id="m-tab-map" class="ui-bottomnav__item" aria-label="Tampilan peta">
            <span class="ui-bnav__icon" id="m-icon-map">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 4 6 2 5.5-2v14L15 20l-6-2-5.5 2V6Z"/><path d="M9 4v14M15 6v14"/></svg>
            </span>
            <span class="ui-bnav__label" id="m-text-map">Peta</span>
        </button>

        <% if (typeof isCustomer !== 'undefined' && isCustomer || typeof isAdmin !== 'undefined' && isAdmin) { %>
