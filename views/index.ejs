                                <h4 style="font-size:12px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${cam.nama}</h4>
                                ${!canView ? '<svg width="11" height="11" fill="currentColor" viewBox="0 0 20 20" style="color:var(--danger-text);flex:none" aria-label="Butuh akses" role="img"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path></svg>' : ''}
                            </div>
                            <p style="font-size:11px;color:var(--fg-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${cam.lokasi || 'Live'}</p>
                            <span class="camera-status-text ui-status-text is-checking" data-camera-id="${cam.id}">memeriksa...</span>
                        </div>

                        ${isSelected ? '<span style="width:6px;height:6px;border-radius:50%;background:var(--accent-text);flex:none" aria-hidden="true"></span>' : ''}
