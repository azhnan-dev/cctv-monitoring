<%#
  Shared footer scripts for auth pages: password visibility toggle, inline
  required-field validation with a focusable error summary, service worker and
  the PWA install banner. Nothing here touches credentials or form action.

  Locals: base_path
%>
<script>
    (function () {
        'use strict';

        /* ---- Password visibility ---- */
        document.addEventListener('click', function (event) {
            var btn = event.target.closest('[data-toggle-pass]');
            if (!btn) return;
            var input = document.getElementById(btn.getAttribute('data-toggle-pass'));
            if (!input) return;
            var show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            btn.setAttribute('aria-pressed', String(show));
            btn.setAttribute('aria-label', show ? 'Sembunyikan kata sandi' : 'Tampilkan kata sandi');
        });

        /* ---- Client-side required validation (server still validates) ---- */
        var form = document.querySelector('[data-auth-form]');
        if (form) {
            form.addEventListener('submit', function (event) {
                var invalid = 0;
                form.querySelectorAll('.ui-input[required]').forEach(function (input) {
                    var hint = document.getElementById(input.id + '-error');
                    var bad = input.value.trim() === '';
                    if (hint) hint.hidden = !bad;
                    input.setAttribute('aria-invalid', String(bad));
                    if (bad) invalid += 1;
                });
                if (invalid > 0) {
                    event.preventDefault();
                    var summary = document.getElementById('auth-error-summary');
                    if (summary) {
                        summary.hidden = false;
                        summary.textContent = invalid + ' kolom belum diisi. Periksa kolom yang ditandai.';
                    }
                    var firstBad = form.querySelector('.ui-input[aria-invalid="true"]');
                    if (firstBad) firstBad.focus();
                }
            });
        }

        /* ---- PWA ---- */
        var basePath = '<%= base_path %>' || '';
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register(basePath + '/sw.js').catch(function () { });
            });
        }

        var deferredPrompt = null;

        function showBanner() {
            if (document.getElementById('pwa-install-banner')) return;
            var banner = document.createElement('div');
            banner.id = 'pwa-install-banner';
            banner.style.cssText = 'position:fixed;left:12px;right:12px;bottom:12px;z-index:9999;display:flex;gap:10px;align-items:center;justify-content:space-between;padding:12px 14px;background:var(--surface);border:1px solid var(--border-strong);border-radius:10px;color:var(--fg);font:600 12px/1.3 var(--font-ui);';
            banner.innerHTML = '<div style="display:flex;flex-direction:column;gap:2px"><div style="font-weight:600;font-size:11px;color:var(--fg-muted)">Install</div><div>Pasang aplikasi untuk akses lebih cepat.</div></div><div style="display:flex;gap:8px;flex-shrink:0"><button id="pwa-install-btn" style="padding:8px 12px;border-radius:6px;background:var(--accent);color:var(--accent-fg);border:0;font-weight:600;font-size:12px;cursor:pointer">Install</button><button id="pwa-close-btn" style="padding:8px 12px;border-radius:6px;background:transparent;color:var(--fg-muted);border:1px solid var(--border-strong);font-weight:600;font-size:12px;cursor:pointer">Tutup</button></div>';
            document.body.appendChild(banner);
            document.getElementById('pwa-close-btn').onclick = function () { banner.remove(); };
            document.getElementById('pwa-install-btn').onclick = function () {
                if (!deferredPrompt) return;
                banner.remove();
                deferredPrompt.prompt();
                deferredPrompt = null;
            };
        }

        window.addEventListener('beforeinstallprompt', function (e) {
            e.preventDefault();
            deferredPrompt = e;
            showBanner();
        });

        window.addEventListener('appinstalled', function () {
            deferredPrompt = null;
            var b = document.getElementById('pwa-install-banner');
            if (b) b.remove();
        });
    })();
</script>
</body>
</html>
