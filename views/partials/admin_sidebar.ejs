<%
// ========== HELPER FUNCTIONS ==========
function renderMenuItem(basePath, href, pageName, currentPage, iconPath, label, isNew) {
    const active = currentPage === pageName;
    const newBadge = isNew ? '<span class="ui-badge ui-badge--info" style="margin-left:auto;height:16px;padding:0 5px;font-size:10px">BARU</span>' : '';
    return `<a href="${basePath}/${href}" class="ui-navitem"${active ? ' aria-current="page"' : ''} data-title="${label}" title="${label}">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">${iconPath}</svg>
        <span>${label}</span>
        ${newBadge}
    </a>`;
}

function renderExternalLink(href, label, iconPath) {
    return `<a href="${href}" target="_blank" rel="noopener" class="ui-navitem" data-title="${label}" title="${label}">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">${iconPath}</svg>
        <span>${label}</span>
    </a>`;
}
%>
<!-- ============================================================ -->
<!-- SIDEBAR — grouped navigation, token styled                    -->
<!-- ============================================================ -->
<aside id="adminSidebar" class="ui-sidebar" data-collapsed="false" aria-label="Navigasi admin">

    <!-- Brand + collapse (desktop) -->
    <div class="ui-sidebar__brand">
        <span class="ui-brandmark" aria-hidden="true">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <rect x="2.5" y="6" width="12.5" height="12" rx="2"/><path d="m15 10.5 5.5-3v9l-5.5-3"/>
            </svg>
        </span>
        <div class="ui-sidebar__brandtext">
            <strong>CCTV Alijaya</strong>
            <span>Panel Admin</span>
        </div>
        <button type="button" onclick="toggleSidebar()" id="sidebarToggleBtn"
                class="ui-btn ui-btn--icon" style="margin-left:auto"
                aria-label="Ciutkan sidebar" aria-pressed="false" title="Ciutkan sidebar">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9.5 4v16"/>
            </svg>
        </button>
    </div>

    <!-- Navigation -->
    <nav id="sidebarNav" style="flex:1;overflow-y:auto;padding:0 var(--space-2) var(--space-2)" class="custom-scrollbar">

        <div class="ui-navgroup">
            <div class="ui-navgroup__label">Operasi</div>
            <%- renderMenuItem(base_path, 'admin', 'dashboard', page, '<path d="M3.5 10.5 12 4l8.5 6.5V20a1 1 0 0 1-1 1h-4v-6h-7v6h-4a1 1 0 0 1-1-1Z"/>', 'Dashboard') %>
            <%- renderExternalLink(base_path + '/', 'Lihat live', '<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="3"/>') %>
            <%- renderExternalLink(base_path + '/archive', 'Arsip rekaman', '<path d="M12 8v4l3 3m6-3a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>') %>
        </div>

        <div class="ui-navgroup">
            <div class="ui-navgroup__label">Kamera &amp; Media</div>
            <%- renderMenuItem(base_path, 'admin/cameras', 'cameras', page, '<rect x="2.5" y="6" width="12.5" height="12" rx="2"/><path d="m15 10.5 5.5-3v9l-5.5-3"/>', 'Kamera RTSP') %>
            <%- renderMenuItem(base_path, 'admin/cameras?type=embed', 'embed', page, '<path d="M21 12a9 9 0 0 1-9 9m9-9a9 9 0 0 0-9-9m9 9H3m9 9a9 9 0 0 1-9-9"/>', 'Kamera embed') %>
            <%- renderMenuItem(base_path, 'admin/apk-cctv', 'apk_cctv', page, '<rect x="7" y="2.5" width="10" height="19" rx="2"/><path d="M11 18.5h2"/>', 'APK CCTV') %>
            <%- renderMenuItem(base_path, 'admin/p2p-stream', 'p2p_stream', page, '<path d="M13 10V3L4 14h7v7l9-11h-7Z"/>', 'P2P') %>
            <%- renderMenuItem(base_path, 'admin/dvr-apk', 'dvr_apk', page, '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H10a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V10a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/>', 'DVR / NVR') %>
            <%- renderMenuItem(base_path, 'admin/ptz', 'ptz', page, '<circle cx="12" cy="12" r="8.5"/><circle cx="9" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="15" cy="12" r="1"/>', 'PTZ') %>
            <%- renderMenuItem(base_path, 'admin/streaming', 'streaming', page, '<path d="M4 6.5h16v11H4Z"/><path d="m10 10 5 3-5 3Z"/>', 'Streaming') %>
            <%- renderMenuItem(base_path, 'admin/ai-counter', 'ai-counter', page, '<path d="M4 19V10m5 9V6m5 13v-6m5 6V8"/>', 'AI Counter') %>
            <%- renderMenuItem(base_path, 'admin/recordings', 'recordings', page, '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 1.5"/>', 'Rekaman') %>
            <%- renderMenuItem(base_path, 'admin/storage', 'storage', page, '<ellipse cx="12" cy="6.5" rx="7.5" ry="3"/><path d="M4.5 6.5v11c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3v-11"/><path d="M4.5 12c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3"/>', 'Storage') %>
        </div>

        <div class="ui-navgroup">
            <div class="ui-navgroup__label">Manajemen</div>
            <%- renderMenuItem(base_path, 'admin/customers', 'customers', page, '<circle cx="12" cy="8" r="3.5"/><path d="M4.5 20a7.5 7.5 0 0 1 15 0"/>', 'Pelanggan') %>
            <%- renderMenuItem(base_path, 'admin/permissions', 'permissions', page, '<rect x="4.5" y="10.5" width="15" height="9" rx="2"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/>', 'Hak akses') %>
            <%- renderMenuItem(base_path, 'admin/billing', 'billing', page, '<path d="M3.5 8.5h17v10h-17zM3.5 12.5h17M7 16h3"/>', 'Billing') %>
            <%- renderMenuItem(base_path, 'admin/finance', 'finance', page, '<path d="M12 6v12m3-9a3 3 0 0 0-3-2.5C10.3 6.5 9 7.6 9 9s1.3 2 3 2.5 3 1.1 3 2.5-1.3 2.5-3 2.5a3 3 0 0 1-3-2.5"/>', 'Keuangan') %>
        </div>

        <div class="ui-navgroup">
            <div class="ui-navgroup__label">Log &amp; notifikasi</div>
            <%- renderMenuItem(base_path, 'admin/activity', 'activity', page, '<path d="M8 6.5h12M8 12h12M8 17.5h12"/><circle cx="4" cy="6.5" r="1"/><circle cx="4" cy="12" r="1"/><circle cx="4" cy="17.5" r="1"/>', 'Log aktivitas') %>
            <%- renderMenuItem(base_path, 'admin/alerts', 'alerts', page, '<path d="M6 10a6 6 0 1 1 12 0c0 4 1.5 5.5 1.5 5.5h-15S6 14 6 10Z"/><path d="M10 19a2 2 0 0 0 4 0"/>', 'Alert') %>
            <%- renderMenuItem(base_path, 'admin/reports', 'reports', page, '<path d="M12 4.5 21 20H3Z"/><path d="M12 10v4.5M12 17.2v.3"/>', 'Laporan') %>
            <%- renderMenuItem(base_path, 'admin/settings', 'settings', page, '<path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/>', 'Pengaturan') %>
        </div>
    </nav>

    <!-- Footer: theme + logout -->
    <div class="ui-sidebar__foot" style="border-top:1px solid var(--border);padding:var(--space-2);display:flex;flex-direction:column;gap:2px">
        <button type="button" class="ui-navitem" onclick="cctvToggleTheme()" data-theme-toggle aria-pressed="false" aria-label="Aktifkan mode terang" title="Ganti tema">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/>
            </svg>
            <span>Ganti tema</span>
        </button>
        <a href="<%= base_path %>/logout" class="ui-navitem" style="color:var(--danger-text)" title="Keluar">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M14 8V5.5H3v13h11V16"/><path d="M9 12h11m-3.5-3.5L20 12l-3.5 3.5"/>
            </svg>
            <span>Keluar</span>
        </a>
    </div>
</aside>

<!-- Mobile scrim -->
<button id="sidebarOverlay" class="ui-scrim" hidden onclick="closeMobileSidebar()" aria-label="Tutup menu"></button>

<!-- ============================================================ -->
<!-- MAIN CONTENT                                                  -->
<!-- ============================================================ -->
<main class="ui-main">
    <!-- Topbar -->
    <header class="ui-topbar" style="gap:var(--space-2)">
        <button type="button" onclick="openMobileSidebar()" class="ui-btn ui-btn--icon md:hidden" aria-label="Buka menu">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 6.5h16M4 12h16M4 17.5h16"/>
            </svg>
        </button>

        <span class="ui-brandmark md:hidden" aria-hidden="true">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <rect x="2.5" y="6" width="12.5" height="12" rx="2"/><path d="m15 10.5 5.5-3v9l-5.5-3"/>
            </svg>
        </span>

        <label class="ui-search" style="max-width:260px">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="10.5" cy="10.5" r="6"/><path d="m15 15 4.5 4.5"/>
            </svg>
            <input type="search" placeholder="Cari kamera, pelanggan, log" aria-label="Pencarian global">
        </label>

        <div class="ui-topbar__spacer"></div>

        <span class="ui-num" data-admin-clock style="font-size:13px;font-weight:600;color:var(--fg-muted)">--:--:--</span>

        <button type="button" class="ui-btn ui-btn--icon" onclick="cctvToggleTheme()" data-theme-toggle aria-pressed="false" aria-label="Aktifkan mode terang" title="Ganti tema">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"/>
            </svg>
        </button>

        <a href="<%= base_path %>/" class="ui-btn ui-btn--sm">Lihat live</a>
    </header>

    <div class="ui-page">

<script>
(function () {
    'use strict';
    var KEY = 'cctv_sidebar_collapsed';
    var sidebar = document.getElementById('adminSidebar');
    var overlay = document.getElementById('sidebarOverlay');

    window.toggleSidebar = function () {
        if (!sidebar) return;
        var collapsed = sidebar.getAttribute('data-collapsed') !== 'true';
        sidebar.setAttribute('data-collapsed', String(collapsed));
        var btn = document.getElementById('sidebarToggleBtn');
        if (btn) btn.setAttribute('aria-pressed', String(collapsed));
        try { localStorage.setItem(KEY, collapsed ? 'true' : 'false'); } catch (e) {}
    };

    window.openMobileSidebar = function () {
        if (!sidebar) return;
        sidebar.classList.add('is-open');
        if (overlay) overlay.hidden = false;
        document.body.style.overflow = 'hidden';
    };

    window.closeMobileSidebar = function () {
        if (!sidebar) return;
        sidebar.classList.remove('is-open');
        if (overlay) overlay.hidden = true;
        document.body.style.overflow = '';
    };

    try {
        if (localStorage.getItem(KEY) === 'true' && sidebar) sidebar.setAttribute('data-collapsed', 'true');
    } catch (e) {}

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') window.closeMobileSidebar();
    });

    function tick() {
        var els = document.querySelectorAll('[data-admin-clock]');
        if (!els.length) return;
        var now = new Date();
        var text = [now.getHours(), now.getMinutes(), now.getSeconds()]
            .map(function (n) { return String(n).padStart(2, '0'); }).join(':');
        els.forEach(function (el) { el.textContent = text; });
    }
    tick();
    setInterval(tick, 1000);
})();
</script>
